app/M-TEK-windows.zip

# Misc tooling / local data dirs that must never be committed
image-search/
node_modules/
backend/data/

# Local production signing material — distribute out of band, never commit
signing-output/
*.jks
*.p12
*.pfx
*.cer
android/key.properties
app/android/key.properties
